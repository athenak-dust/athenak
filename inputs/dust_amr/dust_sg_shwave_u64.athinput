# Self-gravitating shearing wave of dust particles with gas drag (Johansen et al. 2007, Nature,
# Supplementary Information sec. 1.3.1; Simon et al. 2016, ApJ 822, 55, sec. 2.2.2), problem
# generator dust_sg_shwave.  Units G = Omega = rho_p0 = t_s = 1 (4piG = 4pi), q = 3/2; the wave
# starts at kx0 = -1, ky = 1 with rho_hat = 1e-4 and the particles at rest in the shearing
# frame (Johansen et al.; Simon et al. start at kx0 = 0: <problem>/sgw_nx = 0).  Gravity of the
# dust on the dust only, no back reaction: the gas stays at rest in the shearing frame.
# Box 2pi x 2pi in x-y; the wave is uniform in z, which holds 8 cells (cubic cells, periodic).
# Root 64 x 64 x 8, one lattice particle per cell (Johansen et al.: 64^2, 4 per cell).
# Test: sgwave.dat, the particle amplitudes of rho_p, w_x, w_y against the linear solution
# (columns 9-14), until the wave goes nonlinear at |rho_hat| ~ 0.1 (t ~ 3); the force residual
# against the mode (g_err_l2, g_err_max, per level).

<job>
basename = sgw

<output1>
file_type = hst
dt = 0.1
data_format = %.17e

<mesh>
nghost = 4
nx1 = 64
x1min = -3.141592653589793
x1max = 3.141592653589793
ix1_bc = shear_periodic
ox1_bc = shear_periodic
nx2 = 64
x2min = -3.141592653589793
x2max = 3.141592653589793
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = -0.39269908169872414   # 8 cells of 2pi/64
x3max = 0.39269908169872414
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 8

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 4.0
ndiag = 100

<hydro>
eos = isothermal
iso_sound_speed = 1.0
reconstruct = wenoz
rsolver = hllc

<shearing_box>
qshear = 1.5
omega0 = 1.0

<gravity>
enabled = true
source = dust
kick = dust
four_pi_G = 12.566370614359172   # G = 1
setup = distributed
solver = multigrid
vertical_bc = periodic
rtol = 1e-10

<particles>
particle_type = dust
pusher = imex_dust
ppc = 1

<dust>
nspecies = 1
taus_1 = 1.0
dust_to_gas = 1.0
back_reaction = false
deposit = tsc
dt_cfl = 0.5
coupling = pc2

<problem>
pgen_name = dust_sg_shwave
user_hist = true
rho0 = 1.0
eps_1 = 1.0
cloud_root_random = true      # root parents (point particles on this uniform mesh)
root_placement = lattice
sgw_amp = 1.0e-4
sgw_nx = -1                   # kx0 = -1
sgw_ny = 1                    # ky = 1
sgw_dt = 0.02
sgw_dump_dt = 0.0             # >0: particle force dumps sgw_force.*.csv
