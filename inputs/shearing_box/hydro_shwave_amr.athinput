# Linear compressible shearing wave (Johnson & Gammie 2005; shwave problem generator, ipert = 3) in a 3-D
# shearing box with mesh refinement: root 128 x 128 x 16 on 4 x 4 x 1, MeshBlocks of 32 x 32 x 4, plm + hlle.
# Adaptive: a refined box moved through the domain every 2 time units (<problem>/band_n regions), inside the
# domain and at the shear-periodic x1 faces, with derefinement behind it.
# Test: the y-velocity amplitude dVyc (third column of shwave3.user.hst) up to t = 8.  The refined run should
# lie between uniform runs at 128 x 128 and 256 x 256 in x-y (the wave has no z dependence), and conserve
# the mass to round-off (column mass of shwave3.hydro.hst).
<comment>
problem   = compressible hydro shwave of JG05
reference = 

<job>
basename  = shwave3  # problem ID: basename of output filenames

<mesh>
nghost    = 2         # Number of ghost cells
nx1       = 128      # Number of zones in X1-direction
x1min     = -2.0      # minimum value of X1
x1max     = 2.0       # maximum value of X1
ix1_bc    = shear_periodic  # Inner-X1 boundary condition flag
ox1_bc    = shear_periodic  # Outer-X1 boundary condition flag

nx2       = 128      # Number of zones in X2-direction
x2min     = -2.0      # minimum value of X2
x2max     = 2.0       # maximum value of X2
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3 = 16
x3min     = -0.5      # minimum value of X3
x3max     = 0.5       # maximum value of X3
ix3_bc    = periodic  # Inner-X3 boundary condition flag
ox3_bc    = periodic  # Outer-X3 boundary condition flag

<meshblock>
nx1 = 32
nx2 = 32
nx3       = 4         # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integration algorithm
cfl_number = 0.3      # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1       # cycle limit
tlim       = 8.0      # time limit
ndiag      = 1

<shearing_box>
qshear = 1.5 
omega0 = 1.0 

<hydro>
eos             = isothermal   # EOS type
reconstruct     = plm          # spatial reconstruction method
rsolver         = hlle         # Riemann-solver to be used
iso_sound_speed = 1.0          # isothermal sound speed

<problem>
band_n = 4
band1_t0 = 0.0
band1_t1 = 2.0
band1_x1min = -1.0
band1_x1max = 0.0
band1_x2min = -1.0
band1_x2max = 0.0
band1_x3min = -0.25
band1_x3max = 0.25
band2_t0 = 2.0
band2_t1 = 4.0
band2_x1min = 0.0
band2_x1max = 1.0
band2_x2min = 1.0
band2_x2max = 2.0
band3_t0 = 4.0
band3_t1 = 6.0
band3_x1min = 1.0
band3_x1max = 2.0
band3_x2min = -1.0
band3_x2max = 0.0
band3_x3min = -0.25
band3_x3max = 0.25
band4_t0 = 6.0
band4_t1 = 8.1
band4_x1min = -1.0
band4_x1max = 1.0
band4_x2min = -2.0
band4_x2max = -1.0
band4_x3min = -0.25
band4_x3max = 0.25
pgen_name    = shwave
ipert        = 3       # compressible shwave test (JG05)
d0           = 1.0     # background density
amp          = 0.0004  # amplitude of wave in units of sound speed
nwx          = -4      # number of wavelengths in x-direction
nwy          = 1       # number of wavelengths in y-direction
nwz          = 0       # number of wavelengths in z-direction
user_hist    = true

<output1>
file_type   = hst      # History data dump
dt          = 0.1      # time increment between outputs
data_format = %.17e
user_hist_only = false


<mesh_refinement>
refinement = adaptive
num_levels = 2
ncycle_check = 10
refinement_interval = 100
max_nmb_per_rank = 256

<amr_criterion0>
method = user
