<comment>
problem = free fall of a cold uniform sphere of dust clouds (gravity of the dust only,
          no drag, no shear); reference = the homologous collapse f(t) with the periodic mean
          (dust_freefall.cpp).  Uniform 64^3 here; SMR/AMR variants add <mesh_refinement>.

<job>
basename = FF

<mesh>
nghost = 4
nx1 = 64
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 64
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 64
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = -1
tlim = 0.98
ndiag = 1

<hydro>
eos = isothermal
iso_sound_speed = 1.0
reconstruct = wenoz
rsolver = hlle

<particles>
particle_type = dust
pusher = imex_dust
ppc = 1

<dust>
experimental_mpi = true
nspecies = 1
taus_1 = 1.0e20         # no drag
back_reaction = false
deposit = tsc
dt_cfl = 0.3
drag_solver = local
coupling = pc2
experimental_static_smr = true
experimental_3d = true
experimental_smr_transfer = refinable_cloud
cloud_gather_order = 2
cloud_transition = 2
cloud_p1_split = true
cloud_split_overlap = true
cloud_split_device = true
cloud_merge = false
cloud_resample = false

<problem>
pgen_name = dust_freefall
ff_radius = 0.2
ff_n = 1
ff_dt = 0.02            # diagnostics (t_ff = 1 with the default ff_rho)
rho0 = 1.0
etavk = 0.0
eps_1 = 0.1             # the fixture's own clouds, replaced by the sphere
cloud_root_random = true
random_seed = 2007
root_placement = lattice
dust_test = damping
dust_test_v0 = 0.0
check_equilibrium = false

<gravity>
enabled = true
source = dust
kick = dust
setup = distributed
solver = multigrid
four_pi_G = 1.0
vertical_bc = periodic
rtol = 1e-10
max_iterations = 300
gmres_restart = 24
phase_threads = 1
