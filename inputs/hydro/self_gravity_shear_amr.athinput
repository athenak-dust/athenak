# Physical self-gravitating shearing wave with refine/derefine, no density reset.
# Mixed x2 faces exercise conservative orbital-advection flux correction.
<job>
basename = gravity_shear_amr
<mesh>
nx1 = 16
nx2 = 32
nx3 = 8
nghost = 4
x1min = 0
x1max = 1
x2min = 0
x2max = 1
x3min = 0
x3max = 1
ix1_bc = shear_periodic
ox1_bc = shear_periodic
ix2_bc = periodic
ox2_bc = periodic
ix3_bc = periodic
ox3_bc = periodic
<meshblock>
nx1 = 8
nx2 = 16
nx3 = 8
<mesh_refinement>
refinement = adaptive
num_levels = 2
max_nmb_per_rank = 128
refinement_interval = 1
ncycle_check = 1
<amr_criterion0>
method = user
<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
dtmax = 0.002
tlim = 0.064
nlim = -1
ndiag = 16
<hydro>
eos = isothermal
iso_sound_speed = 1
reconstruct = wenoz
rsolver = hlle
<gravity>
enabled = true
setup = distributed
four_pi_G = 50
vertical_bc = periodic
rtol = 1e-11
<shearing_box>
qshear = 1.5
omega0 = 1
stratified = false
experimental_smr = true
experimental_face_levels = true
flux_correct = true
<problem>
pgen_name = self_gravity_wave
mode = shear
rho0 = 1
amp = 1e-5
phase = 0.37
nwx = 1
nwy = 1
nwz = 0
user_hist = true
scheduled_amr = true
refine_start = 0.016
refine_end = 0.048
refine_x1min = 0
refine_x1max = 0.5
refine_x2min = 0
refine_x2max = 0.5
<output1>
file_type = hst
user_hist_only = true
data_format = %24.16e
dt = 0.002
<output2>
file_type = rst
dt = 0.016
<output3>
file_type = bin
variable = gravity
dt = 0.032
