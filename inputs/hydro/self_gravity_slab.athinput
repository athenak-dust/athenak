# Isolated gravitational slab, periodic horizontal directions. Gas outflow is
# deliberately separate from the isolated potential boundary. Static validation.
<job>
basename = gravity_slab
<mesh>
nx1 = 16
nx2 = 16
nx3 = 16
nghost = 4
x1min = 0
x1max = 1
x2min = 0
x2max = 1
x3min = 0
x3max = 1
ix1_bc = periodic
ox1_bc = periodic
ix2_bc = periodic
ox2_bc = periodic
ix3_bc = outflow
ox3_bc = outflow
<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8
<mesh_refinement>
refinement = static
<refined_region1>
level = 1
x1min = 0
x1max = 0.5
x2min = 0
x2max = 0.5
x3min = 0
x3max = 0.5
<time>
evolution = static
integrator = rk2
cfl_number = 0.3
<hydro>
eos = isothermal
iso_sound_speed = 1
reconstruct = wenoz
rsolver = advect
<gravity>
experimental_gas_source = true   # the gas as a gravity source is experimental
enabled = true
setup = distributed
isolated_method = vacuum
four_pi_G = 1
vertical_bc = isolated
rtol = 1e-11
<problem>
pgen_name = self_gravity_wave
mode = slab
rho0 = 1
amp = 0.1
nwx = 1
nwy = 1
nwz = 0
<output1>
file_type = bin
variable = gravity
dt = 1
